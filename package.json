{
  "name": "@cogni/node-template-root",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "build": "pnpm build:packages && pnpm build:app",
    "build:packages": "pnpm -r --if-present --filter \"./packages/**\" --filter \"./graphs\" build && tsc -b packages/*/tsconfig.json packages/langgraph-graphs/tsconfig.build.json packages/doltgres-schema/tsconfig.json",
    "packages:build": "pnpm build:packages",
    "build:app": "pnpm --filter @cogni/node-template-app build",
    "check:workflow": "node scripts/check-node-ci-workflow.mjs && node scripts/check-node-ci-workflow.test.mjs",
    "conductor:setup": "bash scripts/conductor-worktree-setup.sh",
    "codex:cognition:install": "bash scripts/agent/install-codex-cognition-hook.sh",
    "db:generate": "tsx node_modules/drizzle-kit/bin.cjs generate --config=drizzle.config.ts",
    "db:generate:beacon:doltgres": "dotenv -e .env.local -- bash -c 'DATABASE_URL=$DOLTGRES_URL_BEACON tsx node_modules/drizzle-kit/bin.cjs generate --config=drizzle.doltgres.config.ts'",
    "db:check": "pnpm db:check:drizzle && pnpm db:check:beacon:doltgres && pnpm db:check:generate-clean",
    "db:check:beacon:doltgres": "DATABASE_URL=postgres://check@localhost:0/check tsx node_modules/drizzle-kit/bin.cjs check --config=drizzle.doltgres.config.ts",
    "db:check:drizzle": "DATABASE_URL=postgres://check@localhost:0/check tsx node_modules/drizzle-kit/bin.cjs check --config=drizzle.config.ts",
    "db:check:generate-clean": "node scripts/db/check-generate-clean.mjs",
    "db:migrate:direct": "tsx node_modules/drizzle-kit/bin.cjs migrate --config=drizzle.config.ts",
    "db:migrate:beacon:doltgres": "dotenv -e .env.local -- bash -c 'DATABASE_URL=$DOLTGRES_URL_BEACON tsx node_modules/drizzle-kit/bin.cjs migrate --config=drizzle.doltgres.config.ts'",
    "typecheck": "pnpm --filter @cogni/node-template-graphs typecheck && pnpm --filter @cogni/node-template-doltgres-schema typecheck && pnpm --filter @cogni/node-template-app typecheck",
    "test": "pnpm --filter @cogni/node-template-graphs test && pnpm --filter @cogni/node-template-app test",
    "test:ci": "pnpm test",
    "test:component": "pnpm --filter @cogni/node-template-app test:component",
    "check": "pnpm check:workflow && pnpm db:check && pnpm packages:build && pnpm typecheck && pnpm test:ci"
  },
  "pnpm": {
    "overrides": {
      "@assistant-ui/react": "0.12.10",
      "@assistant-ui/react-ai-sdk": "1.3.7",
      "@assistant-ui/react-data-stream": "0.12.4",
      "@assistant-ui/react-markdown": "0.12.3"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.7",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "yaml": "^2.8.3"
  },
  "dependencies": {
    "@cogni-dao/work-items": "https://github.com/cogni-dao/node-template/releases/download/work-items-v0.4.0/cogni-dao-work-items-0.4.0.tgz",
    "@cogni-dao/knowledge-store": "https://github.com/cogni-dao/node-template/releases/download/knowledge-store-v0.8.0/cogni-dao-knowledge-store-0.8.0.tgz",
    "@cogni/ai-tools": "https://github.com/cogni-dao/node-template/releases/download/ai-tools-v0.3.0/cogni-dao-ai-tools-0.3.0.tgz",
    "@cogni/shared-langgraph-graphs": "https://github.com/cogni-dao/node-template/releases/download/langgraph-graphs-v0.2.1/cogni-dao-langgraph-graphs-0.2.1.tgz",
    "viem": "2.39.3",
    "react": "19.0.0",
    "next-auth": "^4.24.10",
    "@tanstack/react-query": "5.90.10",
    "@rainbow-me/rainbowkit": "2.2.9",
    "pino": "^10.1.0",
    "@assistant-ui/react": "0.12.10",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.552.0",
    "radix-ui": "^1.4.3",
    "react-dom": "19.0.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2"
  }
}
